{
  "_comment": "SBG section catalog: the single declarative source of truth for the metadata-section schema. The Python backend derives its tables from it through server/schema.py, and the frontend receives derived values through the API, in meta_keys and in the search schema that config carries.",

  "flags": ["source_app", "initial_image", "initial_images", "initial_audios", "has_workflow", "has_prompt", "prompt_enhanced"],
  "non_bindable_flags": ["initial_images", "initial_audios", "has_workflow", "has_prompt", "prompt_enhanced"],
  "non_bindable_element_keys": { "samplers": ["stage", "role", "label"], "loras": ["loader", "role"] },

  "search": {
    "index_exclude_leaf_keys": ["_node_id", "_feeds", "_handled", "_from"],
    "any_key_exclude_paths": ["samplers.sampler_name", "workflow_nodes.class_type", "workflow_nodes.title", "workflow_nodes.is_vlm"],
    "offered_prefixes": [
      "name:", "model:", "vae:", "clip:", "lora:", "sampler:", "controlnet:",
      "prompt:", "positive:", "negative:", "keyword:", "app:", "tags:",
      "lyrics:", "track:", "mmaudio:", "sampling:", "adetailer:", "upscaling:",
      "interpolation:", "fileinfo:", "file info:", "extra:", "workflow_nodes:",
      "workflow nodes:"
    ],
    "plain_exclude_paths": ["negative_prompt"],
    "prose_paths": ["positive_prompt", "negative_prompt", "initial_prompt"],
    "prose_length_threshold": 400,
    "extra_fields": [
      { "field": "app", "aliases": [], "server_aliases": ["source_app"], "paths": ["source_app"], "count": "entries", "presence_paths": [] },
      { "field": "sampler", "aliases": [], "server_aliases": ["sampler_name"], "paths": ["samplers.sampler_name", "sampler_name"], "count": "entries" },
      { "field": "vae", "aliases": [], "paths": ["vae", "audio_vae"], "count": "entries", "plain_badge": "model" },
      { "field": "clip", "aliases": [], "paths": ["clip_models", "text_projection"], "count": "entries", "plain_badge": "model" },
      { "field": "keyword", "aliases": [], "paths": ["positive_prompt", "negative_prompt"], "badges": ["pos_prompt", "neg_prompt"], "count": "occurrences" },
      { "field": "pos_prompt", "aliases": ["positive prompt"], "server_aliases": ["positive"], "paths": ["positive_prompt"], "count": "occurrences" },
      { "field": "neg_prompt", "aliases": ["negative prompt"], "server_aliases": ["negative"], "paths": ["negative_prompt"], "count": "occurrences" }
    ]
  },

  "sections": [
    {
      "key": "file_info", "section_id": "file_info", "title": "File Info", "kind": "fileinfo",
      "search_field": "fileinfo", "search_aliases": ["file_info"], "server_aliases": ["file info"],
      "search_count": "entries", "search_keys": false,
      "search_paths": ["resolution", "codec", "fps", "total_frames", "duration", "duration_seconds"],
      "summary_keys": ["resolution", "generation_resolution", "width", "height", "duration", "duration_seconds", "codec", "fps", "total_frames", "sample_rate", "channels", "bitrate"],
      "media": ["image", "video", "audio"]
    },
    {
      "key": "model", "section_id": "models", "title": "Models", "kind": "scalar",
      "search_field": "model", "search_aliases": ["models"],
      "search_count": "entries", "search_keys": false,
      "search_paths": ["model"],
      "summary_keys": ["model", "vae", "clip_skip", "clip_models", "text_projection", "audio_vae"],
      "media": ["image", "video", "audio"]
    },
    {
      "key": "positive_prompt", "section_id": "positive", "title": "Positive Prompt", "kind": "text",
      "search_field": "prompt", "search_aliases": [],
      "search_count": "occurrences", "search_keys": false,
      "search_paths": ["positive_prompt"], "search_badges": ["pos_prompt"],
      "summary_keys": ["positive_prompt"],
      "media": ["image", "video", "audio"]
    },
    {
      "key": "negative_prompt", "section_id": "negative", "title": "Negative Prompt", "kind": "text",
      "search_field": "prompt", "search_aliases": [],
      "search_count": "occurrences", "search_keys": false,
      "search_paths": ["negative_prompt"], "search_badges": ["neg_prompt"],
      "summary_keys": ["negative_prompt"],
      "media": ["image", "video", "audio"]
    },
    {
      "key": "initial_prompt", "section_id": "initial_prompt", "title": "Original Prompt (pre-enhance)", "kind": "text",
      "search_field": "prompt", "search_aliases": [],
      "search_count": "occurrences", "search_keys": false,
      "search_paths": [],
      "summary_keys": ["initial_prompt"],
      "media": ["image", "video", "audio"]
    },
    {
      "key": "track", "section_id": "track", "title": "Track", "kind": "object",
      "search_field": "track", "search_aliases": ["artist", "album"],
      "search_count": "occurrences", "search_keys": true,
      "search_paths": ["track"],
      "summary_keys": ["track"],
      "media": ["audio"]
    },
    {
      "key": "audio_tags", "section_id": "audio_tags", "title": "Tags", "kind": "text",
      "search_field": "tags", "search_aliases": ["tag", "audio_tags"],
      "search_count": "occurrences", "search_keys": false,
      "search_paths": ["audio_tags"],
      "summary_keys": ["audio_tags"],
      "media": ["audio"]
    },
    {
      "key": "audio_lyrics", "section_id": "audio_lyrics", "title": "Lyrics", "kind": "text",
      "search_field": "lyrics", "search_aliases": ["lyric", "audio_lyrics"],
      "search_count": "occurrences", "search_keys": false,
      "search_paths": ["audio_lyrics"],
      "summary_keys": ["audio_lyrics"],
      "media": ["audio"]
    },
    {
      "key": "samplers", "section_id": "sampling", "title": "Sampling", "kind": "array",
      "search_field": "sampling", "search_aliases": ["samplers"],
      "search_count": "occurrences", "search_keys": true,
      "search_paths": ["samplers", "sampler_name", "clip_skip", "shift", "sampling_type"],
      "summary_keys": ["samplers", "shift", "sampling_type"],
      "media": ["image", "video", "audio"]
    },
    {
      "key": "loras", "section_id": "loras", "title": "LoRAs", "kind": "array",
      "search_field": "lora", "search_aliases": ["loras"],
      "search_count": "entries", "search_keys": false,
      "search_paths": ["loras"], "search_value_paths": ["loras.name"],
      "summary_keys": ["loras"],
      "media": ["image", "video", "audio"]
    },
    {
      "key": "controlnet", "section_id": "controlnet", "title": "ControlNet", "kind": "array",
      "search_field": "controlnet", "search_aliases": [],
      "search_count": "entries", "search_keys": false,
      "search_paths": ["controlnet"], "search_value_paths": ["controlnet.model"],
      "summary_keys": ["controlnet"],
      "media": ["image", "video"]
    },
    {
      "key": "adetailer", "section_id": "adetailer", "title": "ADetailer", "kind": "array",
      "search_field": "adetailer", "search_aliases": [],
      "search_count": "occurrences", "search_keys": true,
      "search_paths": ["adetailer"],
      "summary_keys": ["adetailer"],
      "media": ["image", "video"]
    },
    {
      "key": "upscaling", "section_id": "upscaling", "title": "Upscaling", "kind": "array",
      "search_field": "upscaling", "search_aliases": [],
      "search_count": "occurrences", "search_keys": true,
      "search_paths": ["upscaling"],
      "summary_keys": ["upscaling"],
      "media": ["image", "video"]
    },
    {
      "key": "interpolation", "section_id": "interpolation", "title": "Interpolation", "kind": "array",
      "search_field": "interpolation", "search_aliases": [],
      "search_count": "occurrences", "search_keys": true,
      "search_paths": ["interpolation"],
      "summary_keys": ["interpolation"],
      "media": ["image", "video"]
    },
    {
      "key": "mmaudio", "section_id": "mmaudio", "title": "MMAudio", "kind": "object",
      "search_field": "mmaudio", "search_aliases": [],
      "search_count": "occurrences", "search_keys": true,
      "search_paths": ["mmaudio"],
      "summary_keys": ["mmaudio"],
      "media": ["image", "video"]
    },
    {
      "key": "extra", "section_id": "extra", "title": "Extra Metadata", "kind": "object",
      "display_name": "Details",
      "search_field": "extra", "search_aliases": ["extra metadata", "details"],
      "search_count": "occurrences", "search_keys": true,
      "search_paths": ["extra"],
      "summary_keys": ["extra"],
      "media": ["image", "video", "audio"]
    },
    {
      "key": "workflow_nodes", "section_id": "workflow_nodes", "title": "Workflow Nodes", "kind": "nodes",
      "search_field": "workflow_nodes", "search_aliases": ["vlm captioner", "prompt enhancer", "aio aux preprocessor"], "server_aliases": ["workflow nodes"],
      "search_count": "occurrences", "search_keys": true,
      "search_paths": ["workflow_nodes"],
      "summary_keys": ["workflow_nodes"],
      "media": ["image", "video", "audio"]
    },
    {
      "key": "raw", "section_id": "raw", "title": "Raw Metadata", "kind": "raw",
      "search_field": null, "search_aliases": [],
      "summary_keys": [],
      "media": ["image", "video", "audio"]
    }
  ]
}
